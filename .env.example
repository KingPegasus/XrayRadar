# Copy to .env and fill in. Never commit .env.

# --- Required ---
XRAYRADAR_DATABASE_URL=postgresql+psycopg2://xrayradar:xrayradar@localhost:5432/xrayradar

# --- Core ---
# XRAYRADAR_ENV=development
# XRAYRADAR_COOKIE_SECURE=false

# Session signing (required for user + admin OAuth sessions)
# XRAYRADAR_SESSION_SECRET=generate-a-long-random-string

# Public URL of this app (email links, CORS-related behavior)
# XRAYRADAR_BASE_URL=http://localhost:8001

# Serve built marketing site from this path (optional; production)
# XRAYRADAR_WEB_DIST=xrayradar-web/dist

# --- Admin UI (GitHub OAuth) ---
# XRAYRADAR_GITHUB_CLIENT_ID=
# XRAYRADAR_GITHUB_CLIENT_SECRET=
# XRAYRADAR_GITHUB_REDIRECT_URI=http://localhost:8001/auth/github/callback
# Comma-separated admin emails: GitHub OAuth allowlist for /admin AND recipients for admin notification emails
# XRAYRADAR_ADMIN_EMAILS=you@example.com

# --- Email (Resend; optional) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# --- Signup caps ---
# XRAYRADAR_MAX_SIGNUPS_PER_DAY=100

# --- Scheduler ---
# XRAYRADAR_SCHEDULER_ENABLED=1
# XRAYRADAR_SCHEDULER_INTERVAL_SECONDS=60

# --- Rate limits (slowapi) ---
# XRAYRADAR_RATE_LIMIT_AUTH=5/minute
# XRAYRADAR_RATE_LIMIT_EVENT_INGEST=100/minute
